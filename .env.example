# ---------------------------------------------------------------------------
# Chronospeed environment. Copy to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored and must never be committed. Only this file (which
# contains no real values) is tracked.
#
# Every variable below is validated at runtime by `src/config/env.ts`. A missing
# or malformed required value fails fast with a message naming the variable only —
# values are never printed, so secrets cannot leak into a log.
# ---------------------------------------------------------------------------

# --- Required in every environment -----------------------------------------

# "development" | "test" | "production"
NODE_ENV=development

# Shared Neon PostgreSQL connection string (the same database used by the admin
# application). Server-only: never prefix this with NEXT_PUBLIC_.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional absolute origin of the deployed site (used for canonical URLs and
# metadata). Must be https:// in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tuning (optional) ------------------------------------------------------

# Pooled connections held by one Chronospeed instance (1-100, default 5).
DATABASE_MAX_CONNECTIONS=5

# --- Phase 2 — customer sessions (active) -----------------------------------
#
# Every value here is optional: the defaults shown are what the application uses
# when the variable is unset.
#
# NOTE: there is deliberately NO session signing secret. A session token is 256
# bits of random data and only its SHA-256 hash is stored, so there is no key to
# configure, leak, or rotate.

# Name of the HttpOnly session cookie.
SESSION_COOKIE_NAME=cs_customer_session

# How long a session stays valid (1-365 days, default 30).
AUTH_SESSION_TTL_DAYS=30

# Consecutive failed sign-ins before the account is temporarily locked
# (3-50, default 5).
AUTH_LOGIN_MAX_ATTEMPTS=5

# How long the account stays locked (1-1440 minutes, default 15).
AUTH_LOGIN_LOCKOUT_MINUTES=15

# Least time allowed between two consecutive failed sign-ins for one account
# (0-300 seconds, default 5).
AUTH_LOGIN_MIN_INTERVAL_SECONDS=5

# In-process rate limit for the auth Server Actions (true | false, default true).
# This is a single-instance limit; a shared store is a Phase 13 item. Set to
# false only to reproduce a rate-limit-free environment locally.
AUTH_RATE_LIMIT_ENABLED=true

# --- Reserved for later phases (leave unset until then) ---------------------
#
# Setting only part of a group is a startup error, by design.

# Phase 9 — Razorpay.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Phase 10 — Shiprocket.
# SHIPROCKET_API_TOKEN=
# SHIPROCKET_WEBHOOK_SECRET=

# Phase 3 — signing for the existing private object-storage bucket. The bucket
# and keys are the ones the admin application already uses; images are never
# uploaded from Chronospeed.
# STORAGE_ENDPOINT_URL=
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_SIGNED_URL_TTL_SECONDS=900