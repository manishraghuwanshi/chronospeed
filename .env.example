# ---------------------------------------------------------------------------
# Chronospeed environment. Copy to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored and must never be committed. Only this file (which
# contains no real values) is tracked.
#
# Every variable below is validated at runtime by `src/config/env.ts`. A missing
# or malformed required value fails fast with a message naming the variable only —
# values are never printed, so secrets cannot leak into a log.
# ---------------------------------------------------------------------------

# --- Required in every environment -----------------------------------------

# "development" | "test" | "production"
NODE_ENV=development

# Shared Neon PostgreSQL connection string (the same database used by the admin
# application). Server-only: never prefix this with NEXT_PUBLIC_.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional absolute origin of the deployed site (used for canonical URLs and
# metadata). Must be https:// in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tuning (optional) ------------------------------------------------------

# Pooled connections held by one Chronospeed instance (1-100, default 5).
DATABASE_MAX_CONNECTIONS=5

# --- Reserved for later phases (leave unset until then) ---------------------
#
# Setting only part of a group is a startup error, by design.

# Phase 4 — customer sessions. AUTH_SECRET must be a random 32+ character string.
# AUTH_SECRET=
# SESSION_COOKIE_NAME=cs_session

# Phase 9 — Razorpay.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Phase 10 — Shiprocket.
# SHIPROCKET_API_TOKEN=
# SHIPROCKET_WEBHOOK_SECRET=

# Phase 3 — signing for the existing private object-storage bucket. The bucket
# and keys are the ones the admin application already uses; images are never
# uploaded from Chronospeed.
# STORAGE_ENDPOINT_URL=
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_SIGNED_URL_TTL_SECONDS=900